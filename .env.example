# Copy this file to .env and fill the values. Never commit .env.

# Token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Your chat id. Leave empty first, send /start to the bot, and it will reply with your id.
TELEGRAM_CHAT_ID=

# Location (Batna, Algeria)
LOCATION_NAME=باتنة
LAT=35.56
LON=6.17
TIMEZONE=Africa/Algiers

# Alert settings
RAIN_THRESHOLD=60
HOURS_AHEAD=3
CHECK_EVERY_MIN=30
RESEND_EVERY_SEC=30
MAX_ATTEMPTS=480
# Quiet period after the forecast drops below the threshold, before a new alert can fire
COOLDOWN_HOURS=1
